plugins {
    id 'nf-ga4gh'
}
process {
    executor = 'tes'
    container = 'quay.io/biocontainers/ubuntu:24.04'
}
tes {
    endpoint = "${env('ENDPOINT')}/ga4gh/tes"
    oauthToken = env('GEN3_TOKEN')
    timeout = 60
    pollInterval = '5 sec'
    tags {
        _GPU = env('GPU')
    }
}
aws {
    accessKey = env('GEN3_TOKEN')
    secretKey = 'N/A'
    region = 'us-east-1'
    client {
        endpoint = "${env('ENDPOINT')}/workflows/s3"
        s3PathStyleAccess = true
        maxErrorRetry = 0
    }
}
workDir = "s3://${env('BUCKET')}/ga4gh-tes"
